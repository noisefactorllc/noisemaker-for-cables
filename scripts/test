#!/bin/sh
# Test entrypoint for pre-publish gating: verify the vendored artifacts against
# vendor.lock.json, run the unit suite, rebuild the op bundle from the vendored
# sources, and confirm the package still packs. Mirrors `npm run check` so a
# gate that runs this entrypoint also regenerates the marked generated bundle.
#
# NM_CHANGED_FILES (one path per line) narrows the run to the checks that
# exercise those paths: vendor:verify and the op-bundle rebuild still run for
# any changed path, a unit test file runs when it names one of the changed
# paths, and a changed browser spec runs through Playwright's runner (which
# starts the fixture server itself). An empty selection falls back to the
# whole unit suite, so no test that exercises a changed path is dropped. With
# NM_CHANGED_FILES unset the whole check runs exactly as before.
# NM_SHARD_INDEX and NM_SHARD_COUNT split the selected unit tests across
# bounded invocations; together the shards run every selected test.
set -eu

if [ -z "${NM_CHANGED_FILES:-}" ]; then
    exec npm run check
fi

changed=$(mktemp)
selected=$(mktemp)
trap 'rm -f "$changed" "$selected"' EXIT
# Matching is by basename inside test-file text. The entrypoint's own basename
# ("test") would match every test file by accident, so a change to the
# entrypoint itself selects nothing and falls back to the whole unit suite.
printf '%s\n' "$NM_CHANGED_FILES" | sed 's|.*/||' | grep -vx -e test > "$changed" || true

# A changed browser spec exercises itself: select it by its changed path.
printf '%s\n' "$NM_CHANGED_FILES" |
    grep -E '^test/browser/[^/]+\.spec\.js$' >> "$selected" || true

for t in test/*.test.js test/browser/*.spec.js; do
    while IFS= read -r name; do
        if [ -n "$name" ] && grep -q -F -e "$name" "$t"; then
            printf '%s\n' "$t" >> "$selected"
            break
        fi
    done < "$changed"
done

# Shard the selected list when the supervisor sets the shard variables.
if [ -n "${NM_SHARD_COUNT:-}" ] && [ -n "${NM_SHARD_INDEX:-}" ]; then
    line=0
    filtered=$(mktemp)
    trap 'rm -f "$changed" "$selected" "$filtered"' EXIT
    while IFS= read -r t; do
        if [ $(( line % NM_SHARD_COUNT )) -eq "$NM_SHARD_INDEX" ]; then
            printf '%s\n' "$t" >> "$filtered"
        fi
        line=$(( line + 1 ))
    done < "$selected"
    mv "$filtered" "$selected"
fi

npm run vendor:verify
if [ -s "$selected" ]; then
    # Browser specs need Playwright's runner; unit test files run under the
    # Node test runner.
    specs=$(grep -E '^test/browser/[^/]+\.spec\.js$' "$selected" || true)
    units=$(grep -v -E '^test/browser/[^/]+\.spec\.js$' "$selected" || true)
    if [ -n "$units" ]; then
        node --test $units
    fi
    if [ -n "$specs" ]; then
        # HOME can be a noexec tmpfs, where an installed browser fails to
        # launch with EACCES. Probe candidate directories by executing a copy
        # of /bin/true there and point Playwright at the first exec-mounted
        # one; the default resolution stays in force when none qualifies.
        probe_exec_root() {
            d=$1
            [ -d "$d" ] || return 1
            cp /bin/true "$d/.nm-exec-probe" 2>/dev/null || return 1
            "$d/.nm-exec-probe" 2>/dev/null || {
                rm -f "$d/.nm-exec-probe"
                return 1
            }
            rm -f "$d/.nm-exec-probe"
        }
        for candidate in "${TMPDIR:-/tmp}" /var/tmp; do
            if probe_exec_root "$candidate"; then
                PLAYWRIGHT_BROWSERS_PATH="$candidate/ms-playwright"
                export PLAYWRIGHT_BROWSERS_PATH
                break
            fi
        done
        # A gate may run on a fresh container: install the browser before the
        # first spec run; the install skips existing browsers. Run every
        # project, so a spec's backend-specific legs each execute in the
        # project whose launch options they need.
        npx playwright install chromium
        npx playwright test $specs
    fi
else
    node --test test/*.test.js
fi
npm run build
npm pack --dry-run
