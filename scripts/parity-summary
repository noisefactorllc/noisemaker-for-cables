#!/usr/bin/env node
// Rendered-parity summary entrypoint for noisemaker-for-cables.
//
// Renders cases of the current authority's effect catalog (the vendored
// noisemaker manifest, parity authority = vendor-cache/effects/manifest.json)
// through the port's browser harness and compares each frame with the
// independent reference rendering of the same core, exactly as the Task 9
// full-catalog sweep does. Given case ids as arguments it renders and counts
// only those ids; with no arguments it renders the whole catalog.
//
// Counting contract (PARITY-SUMMARY line):
//   expected  cases requested (whole catalog when no ids are given)
//   executed  cases that produced a definitive result (exact+strict+near+skip+fail)
//   exact     rendered frames byte-identical to the reference readback at the
//             published zero-channel ceiling
//   strict    rendered passes within the port's numerical contract that are
//             not byte-identical (empty at the zero-channel ceiling)
//   near      tolerated mismatches beyond the contract (none: the contract is
//             zero-channel, so any mismatch is a fail)
//   defer     cases intentionally deferred (reserved; none today)
//   skip      compile-only cases with a visible, recorded exclusion
//   fail      rendered cases outside the contract or failing copy/finite gates
//   missing   requested ids absent from the authority catalog
//
// The last output line is always PARITY-SUMMARY {...}; the exit code is 0
// when fail, missing, and harness sweep failures are all zero, and non-zero
// otherwise (including when the run itself aborts mid-sweep).
import { spawn } from 'node:child_process'
import { readFile } from 'node:fs/promises'
import { createRequire } from 'node:module'
import { fileURLToPath, pathToFileURL } from 'node:url'
import { countCases } from './parity-summary-counting.mjs'

const projectRoot = new URL('..', import.meta.url)
const MANIFEST_PATH = new URL('vendor-cache/effects/manifest.json', projectRoot)
// Must match test/browser/server.mjs: CABLES_FIXTURE_PORT overrides the
// fixture port where only a narrow loopback range is bindable; default 4173.
const BASE_URL = `http://127.0.0.1:${Number(process.env.CABLES_FIXTURE_PORT) || 4173}/test/browser/fixture.html`
const BATCH_OVERHEAD_WAIT_MS = 100

const requestedIds = process.argv.slice(2)

// Self-provisioning keeps the entrypoint runnable in a bare checkout of the
// published head: without it, a fresh clone with no node_modules or no
// Playwright browsers aborts with an environment error instead of a parity
// measurement. Provisioning installs exactly what package.json and the
// installed Playwright version pin; it never changes a dependency pin.
const runTool = (command, args, options = {}) => new Promise((resolve) => {
  const child = spawn(command, args, { stdio: 'inherit', ...options })
  child.on('error', () => resolve(false))
  child.on('close', (code) => resolve(code === 0))
})

const loadChromium = async () => {
  try {
    return (await import('playwright')).chromium
  } catch (error) {
    if (error?.code !== 'ERR_MODULE_NOT_FOUND') throw error
    console.error('parity-summary: playwright is not installed; running npm install --no-save')
    if (!await runTool('npm', ['install', '--no-save', '--no-audit', '--no-fund'], {
      cwd: fileURLToPath(projectRoot),
    })) {
      throw new Error('npm install failed; self-provisioning needs the npm CLI and network access')
    }
    return (await import('playwright')).chromium
  }
}

const launchSweepBrowser = async (chromium, launchOptions) => {
  try {
    return await chromium.launch(launchOptions)
  } catch (error) {
    const missingExecutable = typeof error?.message === 'string'
      && error.message.includes("Executable doesn't exist")
    // An explicit PLAYWRIGHT_BROWSERS_PATH is caller intent; provisioning must
    // not install somewhere the caller did not choose.
    if (!missingExecutable || process.env.PLAYWRIGHT_BROWSERS_PATH) throw error
    const playwrightDir = fileURLToPath(new URL('.', pathToFileURL(
      createRequire(fileURLToPath(projectRoot) + 'package.json').resolve('playwright/package.json'))))
    const cliPath = playwrightDir + 'cli.js'
    console.error('parity-summary: Playwright browsers are missing; running playwright install chromium')
    let installed = false
    try {
      await readFile(cliPath)
      installed = await runTool(process.execPath, [cliPath, 'install', 'chromium'])
    } catch {}
    if (!installed) throw error
    return await chromium.launch(launchOptions)
  }
}

const manifest = JSON.parse(await readFile(MANIFEST_PATH, 'utf8'))
const catalogIds = Object.keys(manifest).sort()

const unknownIds = requestedIds.filter((id) => !catalogIds.includes(id))
if (unknownIds.length > 0) {
  // Unknown ids are reported through the summary's `missing` count, but a
  // request that matches nothing at all is a usage error.
  if (unknownIds.length === requestedIds.length) {
    console.error('no requested case id exists in the authority catalog:', unknownIds.join(', '))
    console.log(`PARITY-SUMMARY ${JSON.stringify({
      defer: 0, exact: 0, expected: requestedIds.length, executed: 0,
      fail: 0, missing: requestedIds.length, near: 0, skip: 0, strict: 0,
    })}`)
    process.exit(1)
  }
  console.error(`warning: requested ids absent from the authority catalog: ${unknownIds.join(', ')}`)
}

const server = spawn(process.execPath, ['test/browser/server.mjs'], {
  cwd: fileURLToPath(projectRoot),
  stdio: 'inherit',
})
let browser
let counts
// Any abort — dev-server startup or browser work — reports the same summary:
// the denominator is the requested id count, or the full authority catalog for
// a no-argument run, instead of 0, with the abort itself counted as one fail.
const reportAbort = (error) => {
  counts ??= {
    defer: 0,
    exact: 0,
    expected: requestedIds.length > 0
      ? requestedIds.length
      : (catalogIds?.length ?? 0),
    executed: 0,
    fail: 0,
    missing: 0,
    near: 0,
    skip: 0,
    strict: 0,
  }
  counts.fail += 1
  console.error('parity-summary aborted:', error && error.message ? error.message : String(error))
  console.log(`PARITY-SUMMARY ${JSON.stringify(counts)}`)
  process.exitCode = 1
}
// A dev server that exits before readiness (sandboxed environments may forbid
// binding sockets) must abort immediately instead of waiting out the full
// readiness deadline.
const serverExited = new Promise((resolve) => {
  server.once('exit', (code, signal) => resolve(
    new Error(`fixture dev server exited before readiness (code ${code ?? 'null'}, signal ${signal ?? 'null'})`)
  ))
})
try {
  await new Promise((resolve, reject) => {
    const deadline = Date.now() + 30_000
    let settled = false
    const poll = async () => {
      if (settled) return
      try {
        const response = await fetch(BASE_URL)
        if (response.ok) {
          settled = true
          return resolve()
        }
      } catch {}
      if (settled) return
      if (Date.now() > deadline) {
        settled = true
        return reject(new Error('dev server did not start'))
      }
      setTimeout(poll, 250)
    }
    poll()
    serverExited.then((error) => {
      settled = true
      reject(error)
    })
  })

  try {
    const chromium = await loadChromium()
    // CABLES_CHROME_CHANNEL opts the sweep onto the host's real Chrome (for
    // example the Apple-silicon GPU host's installed Google Chrome): the
    // default headless shell falls back to SwiftShader for WebGL even where a
    // physical GPU exists, so the physical-GPU measurement needs this opt-in.
    const launchOptions = { headless: true }
    if (process.env.CABLES_CHROME_CHANNEL) {
      launchOptions.channel = process.env.CABLES_CHROME_CHANNEL
      launchOptions.args = ['--headless=new']
    }
    browser = await launchSweepBrowser(chromium, launchOptions)
    const page = await browser.newPage()
    await page.goto(BASE_URL)
    await page.evaluate(() => window.task9Harness.ready)

    // Sorted catalog order as the harness itself sees it, so batch windows line
    // up with the sweep implementation.
    const pageCatalogIds = await page.evaluate(async () => {
      const meta = await window.task9Harness.runFullCatalog({ start: 0, end: 0 })
      return meta.effectNames
    })
    if (JSON.stringify(pageCatalogIds) !== JSON.stringify(catalogIds)) {
      throw new Error('authority catalog and harness catalog disagree')
    }

    const targetIds = requestedIds.length > 0 ? [...new Set(requestedIds)] : catalogIds
    const indices = targetIds
      .map((id) => pageCatalogIds.indexOf(id))
      .filter((index) => index >= 0)
      .sort((a, b) => a - b)

    // Coalesce only exactly consecutive indices into half-open [start, end)
    // batch windows, so a filtered run renders exactly the requested
    // consecutive runs of ids and nothing else.
    const windows = []
    for (const index of indices) {
      const last = windows[windows.length - 1]
      if (last && index === last.end) {
        last.end = index + 1
      } else {
        windows.push({ start: index, end: index + 1 })
      }
    }

    const resultsById = new Map()
    const sweepFailures = []
    for (const window of windows) {
      const batch = await page.evaluate(
        ({ end, start }) => window.task9Harness.runFullCatalog({ end, start }),
        window,
      )
      sweepFailures.push(...batch.failures)
      for (const result of batch.results) resultsById.set(result.id, result)
      await page.waitForTimeout(BATCH_OVERHEAD_WAIT_MS)
    }

    const { counts, records } = countCases(targetIds, resultsById, sweepFailures)
    for (const record of records) {
      console.log(JSON.stringify(record))
    }

    for (const failure of sweepFailures) {
      console.error('sweep failure:', JSON.stringify(failure).slice(0, 400))
    }

    console.log(`PARITY-SUMMARY ${JSON.stringify(counts)}`)
    if (counts.fail > 0 || counts.missing > 0 || sweepFailures.length > 0) {
      process.exitCode = 1
    }
  } catch (error) {
    reportAbort(error)
  }
} catch (error) {
  reportAbort(error)
} finally {
  if (browser) await browser.close().catch(() => {})
  server.kill()
}
